{%- style -%}
  #rl-steps-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; overflow: hidden; }
  #rl-steps-{{ section.id }} .rl-steps { position: relative; display: grid; gap: 2rem; grid-template-columns: 1fr; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 750px) { #rl-steps-{{ section.id }} .rl-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { #rl-steps-{{ section.id }} .rl-steps { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, 1fr); } }
  #rl-steps-{{ section.id }} .rl-route { display: none; }
  @media (min-width: 1100px) {
    #rl-steps-{{ section.id }} .rl-route { display: block; position: absolute; left: 3.6rem; right: 24%; top: 3.4rem; height: 4px;
      background-image: radial-gradient(circle, var(--rl-yellow) 2.5px, transparent 3px); background-size: 18px 4px; background-repeat: repeat-x; }
  }
  #rl-steps-{{ section.id }} .rl-step { position: relative; display: flex; flex-direction: column; gap: 1.2rem; }
  #rl-steps-{{ section.id }} .rl-step__badge {
    position: relative; z-index: 1; width: 7.2rem; height: 7.2rem; border-radius: 999px; display: grid; place-items: center;
    background: var(--rl-yellow); color: var(--rl-navy); font: 800 2.6rem/1 var(--rl-display);
    box-shadow: 0 0 0 8px rgb(var(--color-background));
  }
  #rl-steps-{{ section.id }} .rl-step:last-child .rl-step__badge { background: var(--rl-red-bright); color: #fff; }
  #rl-steps-{{ section.id }} .rl-step__title { margin: .4rem 0 0; font-size: 2.2rem; }
  #rl-steps-{{ section.id }} .rl-step__text { margin: 0; font-size: 1.6rem; line-height: 1.6; color: rgba(var(--color-foreground), .78); max-width: 32rem; }
  @media (min-width: 1100px) {
    #rl-steps-{{ section.id }} .rl-route { animation: rlStepDots 1s linear infinite; }
    #rl-steps-{{ section.id }} .rl-route__parcel { position: absolute; top: -44px; left: 0; width: 40px; height: 40px; margin-left: -20px; animation: rlStepTravel 7s cubic-bezier(.45,0,.55,1) infinite; filter: drop-shadow(0 6px 6px rgba(21,33,61,.25)); }
  }
  #rl-steps-{{ section.id }} .rl-route__parcel svg { display: block; animation: rlStepHop .7s ease-in-out infinite alternate; }
  @keyframes rlStepDots { to { background-position: 18px 0; } }
  @keyframes rlStepTravel { 0% { left: 0; opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { left: 100%; opacity: 0; } }
  @keyframes rlStepHop { from { transform: translateY(0); } to { transform: translateY(-5px); } }
  #rl-steps-{{ section.id }} .rl-step__badge { transition: transform .25s cubic-bezier(.3,1.6,.5,1); }
  #rl-steps-{{ section.id }} .rl-step:hover .rl-step__badge { transform: scale(1.12) rotate(-8deg); }
  @media (prefers-reduced-motion: reduce) {
    #rl-steps-{{ section.id }} .rl-route, #rl-steps-{{ section.id }} .rl-route__parcel, #rl-steps-{{ section.id }} .rl-route__parcel svg { animation: none !important; }
    #rl-steps-{{ section.id }} .rl-route__parcel { display: none; }
  }
{%- endstyle -%}

<section id="rl-steps-{{ section.id }}" class="rl-section color-{{ section.settings.color_scheme }} gradient">
  <svg class="rl-dots-bg" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="rlsd-{{ section.id }}" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.6" fill="currentColor"/></pattern></defs><rect width="100%" height="100%" fill="url(#rlsd-{{ section.id }})"/></svg>
  <div class="rl-container" style="position:relative">
    <div class="rl-head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div>
        <h2 class="rl-head__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="rl-head__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div style="position:relative">
    <span class="rl-route" aria-hidden="true"><span class="rl-route__parcel"><svg viewBox="0 0 40 40" width="40" height="40"><path d="M20 38C14 30 6 25 6 16a14 14 0 1 1 28 0c0 9-8 14-14 22z" fill="#E2432A"/><circle cx="20" cy="16" r="10" fill="#fff"/><rect x="13.5" y="12" width="13" height="9" rx="1" fill="#FFC12E"/><rect x="18.8" y="12" width="2.2" height="9" fill="#15213D"/></svg></span></span>
    <ol class="rl-steps" role="list">
      {%- for block in section.blocks -%}
        <li class="rl-step{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-cascade style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
          <span class="rl-step__badge" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="rl-step__title">{{ block.settings.title | escape }}</h3>
          <p class="rl-step__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RikLoot How it works",
  "tag": "div",
  "class": "section-rl-steps",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our shelf to your address" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Here's what happens after you hit order." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [
    {
      "name": "RikLoot How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick your loot", "text": "Browse by category and add what you love to your cart." } },
        { "type": "step", "settings": { "title": "We pack it", "text": "Your order is checked and packed with care, ready to ship." } },
        { "type": "step", "settings": { "title": "Track every step", "text": "You get a tracking link so you always know where your parcel is." } },
        { "type": "step", "settings": { "title": "At your door", "text": "Open the box and enjoy. Something not right? We'll help." } }
      ]
    }
  ]
}
{% endschema %}
