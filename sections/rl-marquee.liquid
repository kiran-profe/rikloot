{%- style -%}
  #rl-mq-{{ section.id }} { overflow: hidden; padding: {{ section.settings.padding }}px 0; transform: rotate({{ section.settings.tilt }}deg); margin: {{ section.settings.tilt | abs | times: 6 }}px -2rem; position: relative; z-index: 2; }
  #rl-mq-{{ section.id }}.rl-mq--yellow { background: var(--rl-yellow); color: var(--rl-navy); }
  #rl-mq-{{ section.id }}.rl-mq--red { background: var(--rl-red-bright); color: #fff; }
  #rl-mq-{{ section.id }}.rl-mq--navy { background: var(--rl-navy); color: #fff; }
  #rl-mq-{{ section.id }} .rl-mq__track { display: flex; width: max-content; animation: rlMarquee {{ section.settings.speed }}s linear infinite; }
  #rl-mq-{{ section.id }}:hover .rl-mq__track { animation-play-state: paused; }
  #rl-mq-{{ section.id }} .rl-mq__group { display: flex; align-items: center; gap: 2.8rem; padding-right: 2.8rem; flex: none; }
  #rl-mq-{{ section.id }} .rl-mq__item { display: inline-flex; align-items: center; gap: 2.8rem; white-space: nowrap; font: 800 clamp(1.9rem, 2.4vw, 2.8rem)/1 var(--rl-display); text-decoration: none; color: inherit; }
  #rl-mq-{{ section.id }} a.rl-mq__item:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  #rl-mq-{{ section.id }} .rl-mq__star { flex: none; width: 2.2rem; height: 2.2rem; }
  #rl-mq-{{ section.id }}.rl-mq--yellow .rl-mq__star { color: var(--rl-red-bright); }
  #rl-mq-{{ section.id }}.rl-mq--red .rl-mq__star, #rl-mq-{{ section.id }}.rl-mq--navy .rl-mq__star { color: var(--rl-yellow); }
  @keyframes rlMarquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    #rl-mq-{{ section.id }} .rl-mq__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    #rl-mq-{{ section.id }} .rl-mq__group + .rl-mq__group { display: none; }
  }
{%- endstyle -%}

<div style="overflow:hidden"><div id="rl-mq-{{ section.id }}" class="rl-mq rl-mq--{{ section.settings.tone }}">
  <div class="rl-mq__track">
    {%- for g in (1..2) -%}
      <div class="rl-mq__group"{% if forloop.last %} aria-hidden="true"{% endif %}>
        {%- for r in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}
              <a class="rl-mq__item" href="{{ block.settings.link }}"{% if forloop.parentloop.parentloop.last or forloop.parentloop.last %} tabindex="-1"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span class="rl-mq__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
            {%- endif -%}
            <svg class="rl-mq__star" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1l2.8 8.2L23 12l-8.2 2.8L12 23l-2.8-8.2L1 12l8.2-2.8z"/></svg>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div></div>

{% schema %}
{
  "name": "RikLoot Marquee",
  "tag": "section",
  "class": "section-rl-marquee",
  "max_blocks": 10,
  "settings": [
    { "type": "select", "id": "tone", "label": "Colour", "default": "yellow", "options": [ { "value": "yellow", "label": "Yellow" }, { "value": "red", "label": "Red" }, { "value": "navy", "label": "Navy" } ] },
    { "type": "range", "id": "speed", "label": "Speed (seconds per loop, higher is slower)", "min": 10, "max": 80, "step": 2, "default": 36 },
    { "type": "range", "id": "tilt", "label": "Tilt", "min": -3, "max": 3, "step": 1, "default": 0 },
    { "type": "range", "id": "padding", "label": "Height padding", "min": 8, "max": 40, "step": 2, "default": 18, "unit": "px" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "New finds every week" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [
    { "name": "RikLoot Marquee", "blocks": [
      { "type": "item", "settings": { "text": "Kitchen helpers" } },
      { "type": "item", "settings": { "text": "Storage & organisers" } },
      { "type": "item", "settings": { "text": "Handmade crafts" } },
      { "type": "item", "settings": { "text": "Home décor" } },
      { "type": "item", "settings": { "text": "Everyday essentials" } },
      { "type": "item", "settings": { "text": "Gift picks" } }
    ] }
  ]
}
{% endschema %}
