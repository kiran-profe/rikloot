{%- style -%}
  #rl-about-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #rl-about-{{ section.id }} .rl-about__story { display: grid; gap: 3.2rem; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { #rl-about-{{ section.id }} .rl-about__story { grid-template-columns: 1fr 1fr; gap: 6.4rem; } }
  #rl-about-{{ section.id }} .rl-about__media { position: relative; border-radius: calc(var(--rl-radius) * 1.4); background: var(--rl-butter); padding: 3.2rem; }
  #rl-about-{{ section.id }} .rl-about__media img { display: block; width: 100%; height: auto; border-radius: var(--rl-radius); }
  #rl-about-{{ section.id }} .rl-about__media svg { display: block; width: 100%; height: auto; }
  #rl-about-{{ section.id }} .rl-about__tag {
    position: absolute; left: -1rem; bottom: 2.4rem; transform: rotate(-4deg);
    background: var(--rl-red-bright); color: #fff; font: 800 1.8rem/1 var(--rl-display); padding: 1.2rem 1.8rem; border-radius: 12px;
    box-shadow: 0 10px 24px -12px rgba(21,33,61,.6);
  }
  #rl-about-{{ section.id }} h2 { margin: 0 0 1.6rem; font-size: clamp(3rem, 3.8vw, 4.4rem); }
  #rl-about-{{ section.id }} .rl-about__body { font-size: 1.75rem; line-height: 1.7; color: rgba(var(--color-foreground), .85); }
  #rl-about-{{ section.id }} .rl-about__body p { margin: 0 0 1.4rem; }
  #rl-about-{{ section.id }} .rl-about__sign { margin-top: 2rem; font: 700 2.2rem/1.2 var(--rl-display); color: var(--rl-red); }
  #rl-about-{{ section.id }} .rl-values { margin-top: 8rem; }
  #rl-about-{{ section.id }} .rl-values__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6rem; grid-template-columns: 1fr; }
  @media (min-width: 750px) { #rl-about-{{ section.id }} .rl-values__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { #rl-about-{{ section.id }} .rl-values__grid { grid-template-columns: repeat(4, 1fr); } }
  #rl-about-{{ section.id }} .rl-value { padding: 2.4rem; border-radius: var(--rl-radius); background: var(--rl-mist); }
  #rl-about-{{ section.id }} .rl-value:nth-child(2) { background: #FDE8E3; }
  #rl-about-{{ section.id }} .rl-value:nth-child(3) { background: var(--rl-butter); }
  #rl-about-{{ section.id }} .rl-value:nth-child(4) { background: #E3F4EC; }
  #rl-about-{{ section.id }} .rl-value__icon { width: 5.2rem; height: 5.2rem; border-radius: 14px; background: var(--rl-navy); color: var(--rl-yellow); display: grid; place-items: center; margin-bottom: 1.6rem; }
  #rl-about-{{ section.id }} .rl-value h3 { margin: 0 0 .8rem; font-size: 2rem; color: var(--rl-navy); }
  #rl-about-{{ section.id }} .rl-value p { margin: 0; font-size: 1.55rem; line-height: 1.6; color: #3A4664; }
  #rl-about-{{ section.id }} .rl-about__cta {
    margin-top: 6.4rem; padding: 4rem 3.2rem; border-radius: calc(var(--rl-radius) * 1.4); background: var(--rl-navy); color: #fff;
    display: flex; flex-wrap: wrap; gap: 2.4rem; align-items: center; justify-content: space-between;
  }
  #rl-about-{{ section.id }} .rl-about__cta h3 { margin: 0; color: #fff; font-size: clamp(2.4rem, 3vw, 3.4rem); }
  #rl-about-{{ section.id }} .rl-about__cta .button { background: var(--rl-yellow); color: var(--rl-navy); }
  #rl-about-{{ section.id }} .rl-about__cta .button::after { box-shadow: none; }
{%- endstyle -%}

<section id="rl-about-{{ section.id }}" class="rl-section color-{{ section.settings.color_scheme }} gradient">
  <div class="rl-container">
    <div class="rl-about__story">
      <div class="rl-about__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 900px) 50vw, 100vw' }}
        {%- else -%}
          {% render 'rl-art', name: 'team' %}
        {%- endif -%}
        {%- if section.settings.tag != blank -%}<span class="rl-about__tag">{{ section.settings.tag | escape }}</span>{%- endif -%}
      </div>
      <div>
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="rl-about__body">{{ section.settings.story }}</div>
        {%- if section.settings.signature != blank -%}<p class="rl-about__sign">{{ section.settings.signature | escape }}</p>{%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="rl-values">
        <div class="rl-head"><h2 class="rl-head__title">{{ section.settings.values_heading | escape }}</h2></div>
        <ul class="rl-values__grid" role="list">
          {%- for block in section.blocks -%}
            <li class="rl-value{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" data-cascade style="--animation-order: {{ forloop.index }};" {{ block.shopify_attributes }}>
              <span class="rl-value__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'pin' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                  {%- when 'star' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
                  {%- when 'tag' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                  {%- when 'chat' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
                  {%- else -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/></svg>
                {%- endcase -%}
              </span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank -%}
      <div class="rl-about__cta">
        <h3>{{ section.settings.cta_heading | escape }}</h3>
        <a class="button" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RikLoot About story",
  "tag": "div",
  "class": "section-rl-about",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A photo of you, your packing table or your products. Empty shows the built-in illustration." },
    { "type": "text", "id": "tag", "label": "Image sticker", "default": "Est. [YEAR]" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good finds shouldn't be hard to find" },
    { "type": "richtext", "id": "story", "label": "Story", "default": "<p>RikLoot started with a simple idea: the little things that make a home easier, a hobby more fun, or a day smoother should be easy to discover and easy to get.</p><p>So we built one shelf for all of it — clever kitchen helpers, handy organisers, handmade crafts and everyday essentials — picked for usefulness, priced fairly, and tracked from our shelf all the way to your address.</p><p>[Add a line about who you are and why you started RikLoot.]</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "— Team RikLoot" },
    { "type": "text", "id": "values_heading", "label": "Values heading", "default": "What we promise" },
    { "type": "text", "id": "cta_heading", "label": "Closing banner heading", "default": "Ready to grab some good stuff?" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start looting" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "value", "name": "Value", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "box", "options": [
        { "value": "box", "label": "Parcel" }, { "value": "pin", "label": "Location pin" }, { "value": "star", "label": "Star" }, { "value": "tag", "label": "Price tag" }, { "value": "chat", "label": "Chat" } ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Value" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [
    {
      "name": "RikLoot About story",
      "blocks": [
        { "type": "value", "settings": { "icon": "star", "title": "Handpicked, not random", "text": "Every product earns its place on our shelf by being genuinely useful." } },
        { "type": "value", "settings": { "icon": "tag", "title": "Fair prices", "text": "Good stuff at honest prices, with no surprise charges at checkout." } },
        { "type": "value", "settings": { "icon": "pin", "title": "Tracked all the way", "text": "Every order gets a tracking link from dispatch to your doorstep." } },
        { "type": "value", "settings": { "icon": "chat", "title": "Real help", "text": "Questions or issues? Message us and a real person will reply." } }
      ]
    }
  ]
}
{% endschema %}
