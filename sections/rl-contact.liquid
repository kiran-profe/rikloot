{%- style -%}
  #rl-contact-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #rl-contact-{{ section.id }} .rl-c__grid { display: grid; gap: 3.2rem; grid-template-columns: 1fr; }
  @media (min-width: 990px) { #rl-contact-{{ section.id }} .rl-c__grid { grid-template-columns: .85fr 1.15fr; gap: 5.6rem; } }
  #rl-contact-{{ section.id }} h2 { margin: 0 0 1rem; font-size: clamp(2.8rem, 3.4vw, 4rem); }
  #rl-contact-{{ section.id }} .rl-c__intro { margin: 0 0 3.2rem; font-size: 1.7rem; line-height: 1.6; color: rgba(var(--color-foreground), .8); }
  #rl-contact-{{ section.id }} .rl-c__cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; }
  #rl-contact-{{ section.id }} .rl-c__card { display: flex; gap: 1.6rem; align-items: center; padding: 1.8rem 2rem; border-radius: var(--rl-radius); background: var(--rl-mist); color: var(--rl-navy); text-decoration: none; }
  #rl-contact-{{ section.id }} a.rl-c__card:hover { box-shadow: inset 0 0 0 2px var(--rl-navy); }
  #rl-contact-{{ section.id }} .rl-c__ic { flex: none; width: 4.8rem; height: 4.8rem; border-radius: 14px; display: grid; place-items: center; background: var(--rl-navy); color: var(--rl-yellow); }
  #rl-contact-{{ section.id }} .rl-c__card--wa .rl-c__ic { background: #1F8F5A; color: #fff; }
  #rl-contact-{{ section.id }} .rl-c__label { display: block; font-size: 1.35rem; color: #4A5675; }
  #rl-contact-{{ section.id }} .rl-c__value { display: block; font-weight: 600; font-size: 1.7rem; word-break: break-word; }
  #rl-contact-{{ section.id }} .rl-c__form { padding: 3.2rem; border-radius: calc(var(--rl-radius) * 1.4); background: var(--rl-navy); color: #fff; }
  @media (max-width: 749px) { #rl-contact-{{ section.id }} .rl-c__form { padding: 2.2rem 1.8rem; } }
  #rl-contact-{{ section.id }} .rl-c__form h2 { color: #fff; }
  #rl-contact-{{ section.id }} .rl-c__row { display: grid; gap: 1.4rem; grid-template-columns: 1fr; margin-bottom: 1.4rem; }
  @media (min-width: 750px) { #rl-contact-{{ section.id }} .rl-c__row--2 { grid-template-columns: 1fr 1fr; } }
  #rl-contact-{{ section.id }} label { display: block; font-size: 1.4rem; font-weight: 500; margin-bottom: .6rem; color: #D5DDEE; }
  #rl-contact-{{ section.id }} .rl-c__input {
    width: 100%; box-sizing: border-box; min-height: 5rem; padding: 1.2rem 1.6rem; border-radius: 12px;
    border: 2px solid transparent; background: #fff; color: var(--rl-navy); font: 400 1.6rem/1.4 var(--rl-body);
  }
  #rl-contact-{{ section.id }} textarea.rl-c__input { min-height: 15rem; resize: vertical; }
  #rl-contact-{{ section.id }} .rl-c__input:focus { outline: none; border-color: var(--rl-yellow); }
  #rl-contact-{{ section.id }} .rl-c__submit { width: 100%; min-height: 5.4rem; margin-top: .6rem; border: 0; border-radius: 999px; cursor: pointer; background: var(--rl-yellow); color: var(--rl-navy); font: 600 1.7rem/1 var(--rl-body); }
  #rl-contact-{{ section.id }} .rl-c__submit:hover { background: #FFD25E; }
  #rl-contact-{{ section.id }} .rl-c__msg { padding: 1.4rem 1.6rem; border-radius: 12px; margin-bottom: 1.8rem; font-size: 1.55rem; }
  #rl-contact-{{ section.id }} .rl-c__msg--ok { background: #E3F4EC; color: #145A3A; }
  #rl-contact-{{ section.id }} .rl-c__msg--err { background: #FDE8E3; color: #8E2412; }
  #rl-contact-{{ section.id }} .rl-c__note { margin: 1.4rem 0 0; font-size: 1.35rem; color: #B9C4DC; text-align: center; }
  #rl-contact-{{ section.id }} .rl-faq { margin-top: 6.4rem; }
  #rl-contact-{{ section.id }} .rl-faq details { border-bottom: 1px solid rgba(var(--color-foreground), .14); }
  #rl-contact-{{ section.id }} .rl-faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1.6rem; align-items: center; padding: 2rem 0; font-weight: 600; font-size: 1.75rem; }
  #rl-contact-{{ section.id }} .rl-faq summary::-webkit-details-marker { display: none; }
  #rl-contact-{{ section.id }} .rl-faq summary::after { content: "+"; flex: none; width: 3.6rem; height: 3.6rem; border-radius: 999px; display: grid; place-items: center; background: var(--rl-butter); color: var(--rl-navy); font: 700 2.2rem/1 var(--rl-body); }
  #rl-contact-{{ section.id }} .rl-faq details[open] summary::after { content: "–"; background: var(--rl-yellow); }
  #rl-contact-{{ section.id }} .rl-faq__a { padding: 0 0 2rem; font-size: 1.6rem; line-height: 1.65; color: rgba(var(--color-foreground), .82); max-width: 80rem; }
{%- endstyle -%}

<section id="rl-contact-{{ section.id }}" class="rl-section color-{{ section.settings.color_scheme }} gradient">
  <div class="rl-container">
    <div class="rl-c__grid">
      <div>
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}<p class="rl-c__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
        <ul class="rl-c__cards" role="list">
          {%- if section.settings.whatsapp != blank -%}
            {%- assign wa = section.settings.whatsapp | remove: ' ' | remove: '+' | remove: '-' -%}
            <li><a class="rl-c__card rl-c__card--wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">
              <span class="rl-c__ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M9 9.5c.3 2 2.2 4.2 4.5 4.8l1.2-1.2 1.8.8-.4 1.6c-3.6.4-7.6-3.6-7.2-7.2l1.6-.4.8 1.8z"/></svg></span>
              <span><span class="rl-c__label">WhatsApp</span><span class="rl-c__value">{{ section.settings.whatsapp | escape }}</span></span></a></li>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <li><a class="rl-c__card" href="mailto:{{ section.settings.email }}">
              <span class="rl-c__ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
              <span><span class="rl-c__label">Email</span><span class="rl-c__value">{{ section.settings.email | escape }}</span></span></a></li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li><a class="rl-c__card" href="tel:{{ section.settings.phone | remove: ' ' }}">
              <span class="rl-c__ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></span>
              <span><span class="rl-c__label">Phone</span><span class="rl-c__value">{{ section.settings.phone | escape }}</span></span></a></li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li><div class="rl-c__card">
              <span class="rl-c__ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
              <span><span class="rl-c__label">Support hours</span><span class="rl-c__value">{{ section.settings.hours | escape }}</span></span></div></li>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <li><div class="rl-c__card">
              <span class="rl-c__ic" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
              <span><span class="rl-c__label">Address</span><span class="rl-c__value">{{ section.settings.address | escape }}</span></span></div></li>
          {%- endif -%}
        </ul>
      </div>

      <div class="rl-c__form{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <h2>{{ section.settings.form_heading | escape }}</h2>
        {%- form 'contact', id: 'RlContactForm', class: 'rl-c__formel' -%}
          {%- if form.posted_successfully? -%}
            <p class="rl-c__msg rl-c__msg--ok" role="status" tabindex="-1" autofocus>Thanks! Your message is on its way — we'll reply soon.</p>
          {%- elsif form.errors -%}
            <div class="rl-c__msg rl-c__msg--err" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="rl-c__row rl-c__row--2">
            <div><label for="RlName">Your name</label><input class="rl-c__input" id="RlName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></div>
            <div><label for="RlEmail">Email <span aria-hidden="true">*</span></label><input class="rl-c__input" id="RlEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></div>
          </div>
          <div class="rl-c__row rl-c__row--2">
            <div><label for="RlPhone">Phone</label><input class="rl-c__input" id="RlPhone" type="tel" name="contact[phone]" autocomplete="tel" pattern="[0-9\-\+\s]*" value="{{ form.phone }}"></div>
            <div><label for="RlTopic">Topic</label>
              <select class="rl-c__input" id="RlTopic" name="contact[topic]">
                <option>Order status</option><option>Return or exchange</option><option>Product question</option><option>Bulk / business order</option><option>Something else</option>
              </select></div>
          </div>
          <div class="rl-c__row">
            <div><label for="RlOrder">Order number (if any)</label><input class="rl-c__input" id="RlOrder" type="text" name="contact[order_number]" placeholder="#1001"></div>
          </div>
          <div class="rl-c__row">
            <div><label for="RlBody">Message <span aria-hidden="true">*</span></label><textarea class="rl-c__input" id="RlBody" name="contact[body]" required aria-required="true">{{ form.body }}</textarea></div>
          </div>
          <button type="submit" class="rl-c__submit">Send message</button>
          {%- if section.settings.reply_note != blank -%}<p class="rl-c__note">{{ section.settings.reply_note | escape }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="rl-faq">
        <div class="rl-head"><h2 class="rl-head__title">{{ section.settings.faq_heading | escape }}</h2></div>
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="rl-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RikLoot Contact",
  "tag": "div",
  "class": "section-rl-contact",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about an order, a product, or a return? Reach us any way you like." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "With country code, e.g. +91 98765 43210", "default": "+91 [YOUR NUMBER]" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@[yourdomain]" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "hours", "label": "Support hours", "default": "Mon–Sat, 10am–7pm IST" },
    { "type": "text", "id": "address", "label": "Address" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "reply_note", "label": "Note under button", "default": "We usually reply within one working day." },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Quick answers" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ],
  "presets": [
    {
      "name": "RikLoot Contact",
      "blocks": [
        { "type": "faq", "settings": { "question": "How do I track my order?", "answer": "<p>Once your order ships, we email you a tracking link. You can also see it anytime by signing in to your account and opening the order.</p>" } },
        { "type": "faq", "settings": { "question": "How long does delivery take?", "answer": "<p>[Add your typical delivery time, e.g. 5–10 working days across India.]</p>" } },
        { "type": "faq", "settings": { "question": "Can I return a product?", "answer": "<p>[Add your return window and conditions here.] See our Terms & Conditions for full details.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer Cash on Delivery?", "answer": "<p>[Yes / No — update this to match your payment settings.]</p>" } }
      ]
    }
  ]
}
{% endschema %}
