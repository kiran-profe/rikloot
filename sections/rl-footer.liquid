{%- comment -%}
  RikLoot footer
  Brand column (logo, caption, blurb, socials) + Shop / Quick links / Policies / Help columns
  + bottom bar (copyright, payment icons).
  Every link column takes an optional menu from Online Store → Navigation.
  When no menu is picked, it falls back to sensible built-in links, so the footer
  is never empty.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  if s.logo != blank
    assign footer_logo = s.logo
  elsif settings.logo != blank
    assign footer_logo = settings.logo
  endif

  # Find the About / Contact pages: picked page first, then common handles.
  # If none exist, the link is hidden instead of pointing to a 404.
  assign about_url = blank
  if s.about_page != blank
    assign about_url = s.about_page.url
  else
    assign about_handles = 'about-us,about,about-rikloot,our-story' | split: ','
    for h in about_handles
      if pages[h].url != blank
        assign about_url = pages[h].url
        break
      endif
    endfor
  endif

  assign contact_url = blank
  if s.contact_page != blank
    assign contact_url = s.contact_page.url
  else
    assign contact_handles = 'contact,contact-us' | split: ','
    for h in contact_handles
      if pages[h].url != blank
        assign contact_url = pages[h].url
        break
      endif
    endfor
  endif

  assign support_email = s.email | default: shop.email
  assign year = 'now' | date: '%Y'
-%}

{%- style -%}
  #rl-ft-{{ section.id }} {
    position: relative; overflow: hidden;
    padding: {{ s.padding_top }}px 0 0;
    background: var(--rl-navy); color: #fff;
  }
  #rl-ft-{{ section.id }} a { color: inherit; text-decoration: none; }

  /* Delivery route: the footer's one signature moment. */
  #rl-ft-{{ section.id }} .rl-ft__route { position: relative; display: flex; align-items: center; gap: 1.2rem; margin-bottom: 5.6rem; }
  #rl-ft-{{ section.id }} .rl-ft__route-line {
    flex: 1; height: 4px; border-radius: 4px;
    background-image: radial-gradient(circle, var(--rl-yellow) 2px, transparent 2.4px);
    background-size: 14px 4px; background-repeat: repeat-x; background-position: left center; opacity: .55;
  }
  #rl-ft-{{ section.id }} .rl-ft__route-start { flex: none; width: 1.4rem; height: 1.4rem; border-radius: 50%; border: 3px solid var(--rl-yellow); }
  #rl-ft-{{ section.id }} .rl-ft__route-end { flex: none; width: 3.4rem; height: auto; color: var(--rl-red-bright); }
  #rl-ft-{{ section.id }} .rl-ft__route-label { flex: none; font: 700 1.5rem/1 var(--rl-display); color: var(--rl-yellow); white-space: nowrap; }
  @media (max-width: 749px) { #rl-ft-{{ section.id }} .rl-ft__route-label { display: none; } }

  #rl-ft-{{ section.id }} .rl-ft__grid { display: grid; gap: 4rem 2.4rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #rl-ft-{{ section.id }} .rl-ft__brand, #rl-ft-{{ section.id }} .rl-ft__helpcol { grid-column: 1 / -1; }
  @media (min-width: 990px) {
    #rl-ft-{{ section.id }} .rl-ft__grid { grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr)) minmax(0, 1.3fr); gap: 3.2rem; }
    #rl-ft-{{ section.id }} .rl-ft__brand { grid-column: auto; padding-right: 2.4rem; }
    #rl-ft-{{ section.id }} .rl-ft__helpcol { grid-column: auto; }
  }

  /* Brand */
  #rl-ft-{{ section.id }} .rl-ft__logo-link { display: inline-flex; align-items: center; }
  #rl-ft-{{ section.id }} .rl-ft__logo-link--badge { padding: 1.2rem 1.6rem; border-radius: var(--rl-radius-sm); background: #fff; }
  #rl-ft-{{ section.id }} .rl-ft__logo { display: block; width: {{ s.logo_width }}px; max-width: 100%; height: auto; }
  #rl-ft-{{ section.id }} .rl-ft__wordmark { display: inline-flex; align-items: center; gap: 1rem; font: 800 3.4rem/1 var(--rl-display); color: #fff; letter-spacing: -0.01em; }
  #rl-ft-{{ section.id }} .rl-ft__wordmark svg { width: 4.4rem; height: auto; flex: none; }
  #rl-ft-{{ section.id }} .rl-ft__caption { margin: 1.4rem 0 0; font: 700 1.6rem/1.3 var(--rl-display); color: var(--rl-yellow); }
  #rl-ft-{{ section.id }} .rl-ft__blurb { margin: 1.2rem 0 0; max-width: 38rem; font-size: 1.5rem; line-height: 1.65; color: var(--rl-muted-on-dark); }
  #rl-ft-{{ section.id }} .rl-ft__social { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .8rem; padding: 0; }
  #rl-ft-{{ section.id }} .rl-ft__social .list-social__item { list-style: none; }
  #rl-ft-{{ section.id }} .rl-ft__social .list-social__link {
    display: grid; place-items: center; width: 4.2rem; height: 4.2rem; padding: 0; border-radius: 50%;
    background: rgba(255,255,255,.08); color: #fff; transition: background .2s ease, color .2s ease;
  }
  #rl-ft-{{ section.id }} .rl-ft__social .list-social__link:hover { background: var(--rl-yellow); color: var(--rl-navy); }
  #rl-ft-{{ section.id }} .rl-ft__social .svg-wrapper, #rl-ft-{{ section.id }} .rl-ft__social svg { width: 1.8rem; height: 1.8rem; }

  /* Link columns */
  #rl-ft-{{ section.id }} .rl-ft__heading { margin: 0 0 1.6rem; font: 700 1.9rem/1.2 var(--rl-display); color: #fff; }
  #rl-ft-{{ section.id }} .rl-ft__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; }
  #rl-ft-{{ section.id }} .rl-ft__list a {
    display: inline-flex; align-items: center; min-height: 3.4rem; font-size: 1.5rem; line-height: 1.35; color: var(--rl-muted-on-dark);
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; text-decoration-thickness: 2px;
    transition: color .15s ease, text-decoration-color .15s ease;
  }
  #rl-ft-{{ section.id }} .rl-ft__list a:hover { color: #fff; text-decoration-color: var(--rl-yellow); }
  #rl-ft-{{ section.id }} .rl-ft__list a[aria-current="page"] { color: var(--rl-yellow); }

  /* Help column */
  #rl-ft-{{ section.id }} .rl-ft__help { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.4rem; }
  #rl-ft-{{ section.id }} .rl-ft__help li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; font-size: 1.5rem; line-height: 1.45; color: var(--rl-muted-on-dark); }
  #rl-ft-{{ section.id }} .rl-ft__help span { min-width: 0; overflow-wrap: break-word; }
  #rl-ft-{{ section.id }} .rl-ft__help svg { width: 1.8rem; height: 1.8rem; margin-top: .15rem; color: var(--rl-yellow); }
  #rl-ft-{{ section.id }} .rl-ft__help a { color: #fff; word-break: break-word; }
  #rl-ft-{{ section.id }} .rl-ft__help a:hover { text-decoration: underline; text-decoration-color: var(--rl-yellow); text-underline-offset: 4px; }
  #rl-ft-{{ section.id }} .rl-ft__help small { display: block; font-size: 1.3rem; opacity: .8; }

  /* Bottom bar */
  #rl-ft-{{ section.id }} .rl-ft__bottom {
    margin-top: 5.6rem; padding: 2.4rem 0 {{ s.padding_bottom }}px; border-top: 1px solid rgba(255,255,255,.12);
    display: flex; flex-wrap: wrap; gap: 1.6rem 3.2rem; align-items: center; justify-content: space-between;
  }
  #rl-ft-{{ section.id }} .rl-ft__copy { margin: 0; font-size: 1.35rem; line-height: 1.5; color: var(--rl-muted-on-dark); }
  #rl-ft-{{ section.id }} .rl-ft__copy a:hover { color: #fff; text-decoration: underline; }
  #rl-ft-{{ section.id }} .rl-ft__pay { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  #rl-ft-{{ section.id }} .rl-ft__pay svg { display: block; height: 2.4rem; width: auto; border-radius: 4px; }

  @media (prefers-reduced-motion: reduce) {
    #rl-ft-{{ section.id }} * { transition: none !important; }
  }
{%- endstyle -%}

<footer id="rl-ft-{{ section.id }}" class="rl-section rl-ft">
  <div class="rl-container">

    {%- if s.show_route -%}
      <div class="rl-ft__route" aria-hidden="true">
        <span class="rl-ft__route-start"></span>
        <span class="rl-ft__route-line"></span>
        {%- if s.route_label != blank -%}<span class="rl-ft__route-label">{{ s.route_label | escape }}</span>{%- endif -%}
        <svg class="rl-ft__route-end" viewBox="0 0 34 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17 43s15-13.6 15-25.5a15 15 0 0 0-30 0C2 29.4 17 43 17 43z" fill="currentColor"/>
          <rect x="9.5" y="10" width="15" height="13" rx="2" fill="#FFC12E"/>
          <path d="M17 10v13M9.5 15h15" stroke="#15213D" stroke-width="2"/>
        </svg>
      </div>
    {%- endif -%}

    <div class="rl-ft__grid">

      {%- comment -%} Brand {%- endcomment -%}
      <div class="rl-ft__brand">
        <a href="{{ routes.root_url }}" class="rl-ft__logo-link{% if footer_logo and s.logo_badge %} rl-ft__logo-link--badge{% endif %}" aria-label="{{ shop.name | escape }} home">
          {%- if footer_logo -%}
            {{ footer_logo | image_url: width: 600 | image_tag: class: 'rl-ft__logo', loading: 'lazy', width: s.logo_width, alt: shop.name, widths: '200, 300, 400, 600' }}
          {%- else -%}
            <span class="rl-ft__wordmark">
              <svg viewBox="0 0 34 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M17 43s15-13.6 15-25.5a15 15 0 0 0-30 0C2 29.4 17 43 17 43z" fill="#E2432A"/>
                <rect x="9.5" y="10" width="15" height="13" rx="2" fill="#FFC12E"/>
                <path d="M17 10v13M9.5 15h15" stroke="#15213D" stroke-width="2"/>
              </svg>
              {{ shop.name | escape }}
            </span>
          {%- endif -%}
        </a>
        {%- if s.caption != blank -%}<p class="rl-ft__caption">{{ s.caption | escape }}</p>{%- endif -%}
        {%- if s.blurb != blank -%}<p class="rl-ft__blurb">{{ s.blurb | escape }}</p>{%- endif -%}
        {%- if s.show_social -%}{% render 'social-icons', class: 'rl-ft__social' %}{%- endif -%}
      </div>

      {%- comment -%} Shop {%- endcomment -%}
      <nav aria-labelledby="rl-ft-shop-{{ section.id }}">
        <h2 class="rl-ft__heading" id="rl-ft-shop-{{ section.id }}">{{ s.shop_heading | escape }}</h2>
        <ul class="rl-ft__list" role="list">
          {%- if s.shop_menu != blank and s.shop_menu.links.size > 0 -%}
            {%- for link in s.shop_menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
            {%- for c in collections -%}
              {%- if c.handle != 'all' and c.handle != 'frontpage' and c.products_count > 0 -%}
                <li><a href="{{ c.url }}">{{ c.title | escape }}</a></li>
              {%- endif -%}
              {%- if forloop.index >= 6 -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            <li><a href="{{ routes.collections_url }}">All categories</a></li>
          {%- endif -%}
        </ul>
      </nav>

      {%- comment -%} Quick links {%- endcomment -%}
      <nav aria-labelledby="rl-ft-quick-{{ section.id }}">
        <h2 class="rl-ft__heading" id="rl-ft-quick-{{ section.id }}">{{ s.quick_heading | escape }}</h2>
        <ul class="rl-ft__list" role="list">
          {%- if s.quick_menu != blank and s.quick_menu.links.size > 0 -%}
            {%- for link in s.quick_menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.root_url }}">Home</a></li>
            {%- if about_url != blank -%}<li><a href="{{ about_url }}">About us</a></li>{%- endif -%}
            {%- if contact_url != blank -%}<li><a href="{{ contact_url }}">Contact us</a></li>{%- endif -%}
            {%- if s.track_link != blank -%}<li><a href="{{ s.track_link }}">Track your order</a></li>{%- endif -%}
            <li><a href="{{ routes.search_url }}">Search</a></li>
            {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">My account</a></li>{%- endif -%}
            <li><a href="{{ routes.cart_url }}">Cart</a></li>
          {%- endif -%}
        </ul>
      </nav>

      {%- comment -%} Policies {%- endcomment -%}
      <nav aria-labelledby="rl-ft-pol-{{ section.id }}">
        <h2 class="rl-ft__heading" id="rl-ft-pol-{{ section.id }}">{{ s.policy_heading | escape }}</h2>
        <ul class="rl-ft__list" role="list">
          {%- if s.policy_menu != blank and s.policy_menu.links.size > 0 -%}
            {%- for link in s.policy_menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- if s.terms_page != blank -%}<li><a href="{{ s.terms_page.url }}">{{ s.terms_page.title | escape }}</a></li>{%- endif -%}
            {%- for policy in shop.policies -%}
              {%- if policy.body != blank -%}
                {%- if s.terms_page != blank and policy.url == shop.terms_of_service.url -%}{%- continue -%}{%- endif -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
            {%- if s.extra_policy_1 != blank -%}<li><a href="{{ s.extra_policy_1.url }}">{{ s.extra_policy_1.title | escape }}</a></li>{%- endif -%}
            {%- if s.extra_policy_2 != blank -%}<li><a href="{{ s.extra_policy_2.url }}">{{ s.extra_policy_2.title | escape }}</a></li>{%- endif -%}
          {%- endif -%}
        </ul>
      </nav>

      {%- comment -%} Help {%- endcomment -%}
      <div class="rl-ft__helpcol">
        <h2 class="rl-ft__heading">{{ s.help_heading | escape }}</h2>
        <ul class="rl-ft__help" role="list">
          {%- if support_email != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
              <span><a href="mailto:{{ support_email }}">{{ support_email }}</a></span>
            </li>
          {%- endif -%}
          {%- if s.phone != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
              <span><a href="tel:{{ s.phone | remove: ' ' | remove: '-' }}">{{ s.phone | escape }}</a></span>
            </li>
          {%- endif -%}
          {%- if s.whatsapp != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
              <span><a href="https://wa.me/{{ s.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener">Chat on WhatsApp</a></span>
            </li>
          {%- endif -%}
          {%- if s.hours != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <span>{{ s.hours | escape }}</span>
            </li>
          {%- endif -%}
          {%- if s.address != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
              <span>{{ s.address | escape | newline_to_br }}</span>
            </li>
          {%- endif -%}
          {%- if s.grievance != blank -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/></svg>
              <span><small>Grievance officer</small>{{ s.grievance | escape }}</span>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <div class="rl-ft__bottom">
      <p class="rl-ft__copy">
        &copy; {{ year }} <a href="{{ routes.root_url }}">{{ shop.name | escape }}</a>.
        {%- if s.copyright_note != blank %} {{ s.copyright_note | escape }}{% endif -%}
      </p>
      {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="rl-ft__pay" role="list" aria-label="Payment methods we accept">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "RikLoot Footer",
  "tag": "div",
  "class": "section-rl-footer",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Footer logo", "info": "Empty uses the logo from Theme settings. If neither is set, the RikLoot pin and store name are shown." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 300, "step": 10, "unit": "px", "default": 170 },
    { "type": "checkbox", "id": "logo_badge", "label": "Put logo on a white badge", "info": "Turn on if your logo has dark text, so it stays readable on the navy footer.", "default": true },
    { "type": "text", "id": "caption", "label": "Logo caption", "default": "Tracked from our shelf to your address" },
    { "type": "textarea", "id": "blurb", "label": "Short description", "default": "One shelf for kitchen helpers, storage, crafts, décor, gadgets and everyday essentials — picked for usefulness and delivered across India." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "info": "Add your links in Theme settings → Social media.", "default": true },

    { "type": "header", "content": "Delivery route line" },
    { "type": "checkbox", "id": "show_route", "label": "Show route line at the top", "default": true },
    { "type": "text", "id": "route_label", "label": "Route label", "default": "Delivering across India" },

    { "type": "header", "content": "Shop column" },
    { "type": "text", "id": "shop_heading", "label": "Heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Menu", "info": "Empty shows All products, up to 6 of your collections and All categories." },

    { "type": "header", "content": "Quick links column" },
    { "type": "text", "id": "quick_heading", "label": "Heading", "default": "Quick links" },
    { "type": "link_list", "id": "quick_menu", "label": "Menu", "info": "Empty shows Home, About us, Contact us, Track your order, Search, My account and Cart." },
    { "type": "page", "id": "about_page", "label": "About page", "info": "Used when no menu is picked. Empty finds a page with the handle about-us or about." },
    { "type": "page", "id": "contact_page", "label": "Contact page", "info": "Used when no menu is picked. Empty finds a page with the handle contact or contact-us." },
    { "type": "url", "id": "track_link", "label": "Track your order link", "info": "Optional, e.g. your shipping partner's tracking page." },

    { "type": "header", "content": "Policies column" },
    { "type": "text", "id": "policy_heading", "label": "Heading", "default": "Policies" },
    { "type": "link_list", "id": "policy_menu", "label": "Menu", "info": "Empty automatically lists every policy filled in under Settings → Policies, plus the pages below." },
    { "type": "page", "id": "terms_page", "label": "Terms & Conditions page", "info": "Optional. Pick it if your terms live in a page instead of Settings → Policies." },
    { "type": "page", "id": "extra_policy_1", "label": "Extra policy page", "info": "e.g. Cancellation Policy" },
    { "type": "page", "id": "extra_policy_2", "label": "Extra policy page" },

    { "type": "header", "content": "Help column" },
    { "type": "text", "id": "help_heading", "label": "Heading", "default": "Need help?" },
    { "type": "text", "id": "email", "label": "Support email", "info": "Empty uses your store email." },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "With country code, e.g. 919876543210" },
    { "type": "text", "id": "hours", "label": "Support hours", "default": "Mon–Sat, 10 am – 6 pm IST" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "text", "id": "grievance", "label": "Grievance officer", "info": "Name and email. Required for Indian online stores under the Consumer Protection (E-Commerce) Rules." },

    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_note", "label": "Note after copyright", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 120, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 28 }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": [ { "name": "RikLoot Footer" } ]
}
{% endschema %}
