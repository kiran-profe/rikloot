{%- comment -%}
  RikLoot flat illustrations (no external images needed).
  Usage: {% render 'rl-art', name: 'kitchen', class: 'my-class' %}
  Names: kitchen, storage, crafts, decor, essentials, gifts, beauty, gadgets, pin, team
{%- endcomment -%}
{%- liquid
  assign n = name | default: 'pin'
  assign N = '#15213D'
  assign R = '#E2432A'
  assign Y = '#FFC12E'
  assign Yd = '#E59A00'
  assign G = '#3FA77A'
  assign B = '#5C8DF6'
-%}
<svg class="{{ class }}" viewBox="0 0 240 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ n | capitalize }} illustration" focusable="false">
{%- case n -%}
{%- when 'kitchen' -%}
  <ellipse cx="120" cy="178" rx="92" ry="10" fill="{{ N }}" opacity=".12"/>
  <path d="M40 92h110v52a30 30 0 0 1-30 30H70a30 30 0 0 1-30-30z" fill="{{ R }}"/>
  <rect x="32" y="84" width="126" height="16" rx="8" fill="{{ N }}"/>
  <path d="M150 108h18a14 14 0 0 1 0 28h-18" fill="none" stroke="{{ N }}" stroke-width="8"/>
  <path d="M74 70c0-10 10-10 10-22M96 70c0-10 10-10 10-22M118 70c0-10 10-10 10-22" fill="none" stroke="{{ Yd }}" stroke-width="5" stroke-linecap="round"/>
  <rect x="176" y="70" width="14" height="104" rx="7" fill="{{ Y }}"/>
  <circle cx="183" cy="62" r="20" fill="none" stroke="{{ Y }}" stroke-width="10"/>
  <rect x="200" y="96" width="10" height="78" rx="5" fill="{{ N }}"/>
  <path d="M196 56h18v44h-18z" fill="{{ N }}"/>
  <path d="M60 120h70" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".6"/>
{%- when 'storage' -%}
