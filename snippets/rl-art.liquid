  <rect x="34" y="118" width="80" height="58" rx="8" fill="{{ Y }}"/>
  <rect x="28" y="108" width="92" height="16" rx="6" fill="{{ Yd }}"/>
  <rect x="122" y="118" width="84" height="58" rx="8" fill="{{ B }}"/>
  <rect x="116" y="108" width="96" height="16" rx="6" fill="{{ N }}"/>
  <rect x="62" y="48" width="104" height="58" rx="8" fill="{{ R }}"/>
  <rect x="56" y="38" width="116" height="16" rx="6" fill="{{ N }}"/>
  <rect x="96" y="66" width="36" height="20" rx="4" fill="#fff"/>
  <rect x="56" y="140" width="36" height="14" rx="7" fill="#fff" opacity=".8"/>
  <rect x="146" y="140" width="36" height="14" rx="7" fill="#fff" opacity=".8"/>
{%- when 'crafts' -%}
