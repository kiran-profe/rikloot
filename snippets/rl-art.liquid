  <rect x="98" y="96" width="56" height="82" rx="10" fill="{{ Y }}"/>
  <path d="M104 96c0-14 44-14 44 0" fill="{{ Yd }}"/>
  <rect x="108" y="122" width="36" height="22" rx="4" fill="#fff" opacity=".85"/>
  <circle cx="190" cy="140" r="38" fill="{{ R }}"/>
  <circle cx="190" cy="140" r="16" fill="#fff"/>
  <circle cx="190" cy="140" r="6" fill="{{ R }}"/>
{%- when 'gifts' -%}
