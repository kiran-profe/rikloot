  <path d="M140 150c26 10 40 22 58 22" fill="none" stroke="{{ R }}" stroke-width="5" stroke-linecap="round"/>
  <rect x="160" y="30" width="12" height="104" rx="4" fill="{{ Y }}" transform="rotate(24 166 82)"/>
  <rect x="186" y="30" width="12" height="104" rx="4" fill="{{ N }}" transform="rotate(34 192 82)"/>
  <circle cx="186" cy="48" r="8" fill="{{ N }}"/>
  <circle cx="58" cy="44" r="6" fill="{{ Y }}"/><circle cx="34" cy="64" r="4" fill="{{ G }}"/>
{%- when 'decor' -%}
