  <rect x="56" y="54" width="70" height="104" rx="6" fill="{{ B }}"/>
  <circle cx="91" cy="168" r="5" fill="#fff"/>
  <path d="M160 92a30 30 0 0 1 60 0v40" fill="none" stroke="{{ R }}" stroke-width="10" stroke-linecap="round"/>
  <rect x="148" y="112" width="24" height="44" rx="10" fill="{{ R }}"/>
  <rect x="208" y="112" width="24" height="44" rx="10" fill="{{ R }}"/>
  <path d="M68 80h46M68 96h30" stroke="#fff" stroke-width="6" stroke-linecap="round" opacity=".8"/>
{%- when 'team' -%}
  <ellipse cx="120" cy="184" rx="104" ry="8" fill="{{ N }}" opacity=".12"/>
  <rect x="16" y="40" width="96" height="138" rx="6" fill="{{ N }}"/>
  <path d="M16 84h96M16 130h96" stroke="#fff" stroke-width="4" opacity=".25"/>
  <rect x="26" y="58" width="22" height="26" rx="3" fill="{{ Y }}"/><rect x="54" y="64" width="26" height="20" rx="3" fill="{{ R }}"/><rect x="86" y="54" width="16" height="30" rx="3" fill="{{ B }}"/>
  <rect x="28" y="104" width="30" height="26" rx="3" fill="{{ G }}"/><rect x="66" y="108" width="34" height="22" rx="3" fill="{{ Y }}"/>
  <rect x="30" y="150" width="70" height="28" rx="3" fill="{{ R }}" opacity=".9"/>
  <path d="M112 150 C140 176 170 120 196 140" fill="none" stroke="{{ Y }}" stroke-width="6" stroke-dasharray=".1 13" stroke-linecap="round"/>
  <path d="M206 140 C188 116 176 104 176 88 A30 30 0 1 1 236 88 C236 104 224 116 206 140Z" fill="{{ R }}"/>
  <circle cx="206" cy="88" r="20" fill="#fff"/>
  <rect x="194" y="80" width="24" height="18" rx="2" fill="{{ Y }}"/><rect x="204" y="80" width="4" height="18" fill="{{ N }}"/>
{%- else -%}
  <ellipse cx="120" cy="184" rx="40" ry="7" fill="{{ N }}" opacity=".18"/>
  <path d="M30 170 C70 196 92 150 120 176" fill="none" stroke="{{ Y }}" stroke-width="7" stroke-dasharray=".1 15" stroke-linecap="round"/>
  <path d="M120 180 C94 146 66 124 66 86 A54 54 0 1 1 174 86 C174 124 146 146 120 180Z" fill="{{ R }}"/>
  <path d="M84 56 C92 42 104 36 118 34" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="5" stroke-linecap="round"/>
  <circle cx="120" cy="86" r="38" fill="#fff"/>
  <rect x="98" y="74" width="44" height="32" rx="3" fill="{{ Y }}"/>
  <path d="M98 74l8-8h28l8 8z" fill="#FFE08A"/>
  <rect x="116" y="66" width="7" height="40" fill="{{ N }}"/>
  <path d="M190 40l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" fill="{{ Y }}"/>
{%- endcase -%}
